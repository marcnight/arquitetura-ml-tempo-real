# Copie para ".env" (cp .env.example .env) e ajuste se necessário.
# O Docker Compose lê este arquivo automaticamente.

# UID e GID do seu usuário no host (confira com `id -u` e `id -g`).
# Os contêineres gravam em ./medicoes/raw com esse usuário.
HOST_UID=1000
HOST_GID=1000

# Partições dos tópicos "transactions" e "predictions" (vale na criação dos tópicos).
TOPIC_PARTITIONS=3

# Memória de cada worker e de cada executor do Spark.
SPARK_WORKER_MEMORY=1g
SPARK_EXECUTOR_MEMORY=768m

# Total de núcleos que o fluxo pode usar (vazio = todos os disponíveis).
# Com N workers, use 2*N para esperar todos registrarem antes do primeiro micro-lote.
SPARK_CORES_MAX=

# "latest" = processa só o que chegar depois da partida; "earliest" = desde o início do tópico.
STARTING_OFFSETS=latest

# 1 = imprime as predições no log do driver (depuração; refaz a inferência em uma segunda consulta).
ENABLE_CONSOLE_SINK=0
